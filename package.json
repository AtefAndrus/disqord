{
  "name": "disqord",
  "version": "1.4.0",
  "description": "Discord bot that connects to OpenRouter for LLM conversations",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "bun biome check .",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\"",
    "format": "bun biome format --write .",
    "format:md": "markdownlint-cli2 --fix \"docs/**/*.md\" \"*.md\"",
    "generate:readme": "bun scripts/generate-readme.ts",
    "prepare": "lefthook install"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/node": "^25.4.0",
    "bun-types": "^1.3.10",
    "lefthook": "^2.1.4",
    "markdownlint-cli2": "^0.21.0",
    "typescript": "^5.6.3"
  }
}
