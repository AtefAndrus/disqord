{
  "name": "disqord",
  "version": "1.18.0",
  "description": "Discord bot that connects to OpenRouter for LLM conversations",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "bun biome check .",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\"",
    "format": "bun biome format --write .",
    "format:md": "markdownlint-cli2 --fix \"docs/**/*.md\" \"*.md\"",
    "changelog": "git-cliff --output CHANGELOG.md",
    "generate:readme": "bun scripts/generate-readme.ts",
    "preview": "playwright install chromium-headless-shell && bun scripts/preview/index.ts",
    "e2e": "bun scripts/e2e/index.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "croner": "10.0.1",
    "discord.js": "14.27.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@skyra/discord-components-core": "4.0.2",
    "@types/node": "26.6.5",
    "bun-types": "1.4.4",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
